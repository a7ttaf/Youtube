UMS_DATABASE_URL=postgresql+psycopg://<user>:<password>@localhost:5432/ums_smart_revenue
UMS_AUTHZ_SOURCE=headers
# Declared bootstrap-tenant reporting label in headers mode. Database mode
# ignores this value and reads tenants.primary_currency; its later EGP flip
# requires a controlled tenant-row data migration/backfill. USD stays default.
UMS_TENANT_PRIMARY_CURRENCY=USD
UMS_TRUSTED_GATEWAY_TOKEN=dev-only-token
# Required only for live Google connector jobs; provision through the audited API.
# Compose does not forward this variable. Supply a real UUID in the runtime
# environment or an untracked Compose override; never use a public placeholder.
# UMS_GOOGLE_CONNECTOR_SERVICE_ACTOR_ID=<provisioned-service-actor-uuid>
# Demo/self-host opt-in: path to a JSON file mapping local-secret:// names to
# OAuth payload strings, e.g. {"yt-owner": "{\"refresh_token\": ...}"}. When
# set, connector credentials may reference local-secret://<name>; when unset
# (production default) only real secret-manager refs are accepted.
# UMS_CONNECTOR_LOCAL_SECRETS_FILE=/run/secrets/connector-secrets.json

# Compose-only storage identity. Run the prepare command in
# Docs/20_COMPOSE_STORAGE_RUNBOOK.md before uncommenting the host path.
# UMS_APP_DATA_HOST=./data/ums
# APP_UID=10001
# UMS_APP_DATA_HOST_CANONICAL and UMS_APP_DATA_HOST_CONFIGURED are intentionally
# omitted. The storage wrapper derives those host-validation receipts.

# ---------------------------------------------------------------------------
# Frontend dev proxy (development only — vite.config.ts reads these in Node).
# VITE_* names are EXPOSED to the client bundle via import.meta.env, so the
# trusted-gateway secret MUST stay on the non-VITE name above and never gain
# a VITE_ alias here.
# ---------------------------------------------------------------------------
# VITE_DEV_BACKEND_URL=http://127.0.0.1:8000
# Non-loopback targets require HTTPS and fail closed unless their exact origin is listed here.
# This is Node-side trust config and must never use a VITE_* name.
# UMS_DEV_TRUSTED_BACKEND_ORIGINS=https://dev-api.example.internal
# VITE_DEV_GATEWAY_USER_ID=00000000-0000-0000-0000-0000000000aa
# VITE_DEV_GATEWAY_USER_EMAIL=dev@ums.local
# VITE_DEV_GATEWAY_ROLE=assistant_analyst
# VITE_DEV_GATEWAY_SCOPE_TYPE=global
# Required when scope type is not global; must stay absent for global scope.
# VITE_DEV_GATEWAY_SCOPE_ID=company-a
# Tenant slug the dev proxy injects on every tenant-scoped request. The
# frontend bootstraps with an empty slug so the trusted gateway / proxy is
# the source of truth, matching the production reverse-proxy contract.
# VITE_DEV_GATEWAY_TENANT_SLUG=ums
