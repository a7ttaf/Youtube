UMS_DATABASE_URL=postgresql+asyncpg://<user>:<password>@localhost:5432/ums_smart_revenue
UMS_AUTHZ_SOURCE=headers
UMS_TRUSTED_GATEWAY_TOKEN=<set-a-local-development-token>

# ---------------------------------------------------------------------------
# Frontend dev proxy (development only — vite.config.ts reads these in Node).
# VITE_* names are EXPOSED to the client bundle via import.meta.env, so the
# trusted-gateway secret MUST stay on the non-VITE name above and never gain
# a VITE_ alias here.
# ---------------------------------------------------------------------------
# VITE_DEV_BACKEND_URL=http://127.0.0.1:8000
# VITE_DEV_GATEWAY_USER_ID=00000000-0000-0000-0000-0000000000aa
# VITE_DEV_GATEWAY_USER_EMAIL=dev@ums.local
# VITE_DEV_GATEWAY_ROLE=assistant_analyst
# VITE_DEV_GATEWAY_SCOPE_TYPE=global
