# Default: normalize tracked text files to LF in the repository. `text=auto`
# lets Git auto-detect binary files and leave them untouched. This prevents
# CRLF from leaking into committed source on Windows checkouts, since
# core.autocrlf is intentionally false in this repo.
* text=auto eol=lf

# Vendored agent content (Claude Code / Codex agents skills + GitHub theme
# JSON5 files + GitHub font licenses). Sources tracked in skills-lock.json
# and mockups/FontsGH/README.md. Trailing whitespace and indentation may
# not match the repository's whitespace rules; disable the whitespace
# check on these paths so `git diff --check` does not flag upstream
# artifacts.
.agents/** -whitespace

# Vendored OFL-1.1 font license text. Must be preserved verbatim per the
# license; upstream contains trailing whitespace on at least one line.
# Source: SIL OFL 1.1 license body shipped alongside Mona Sans,
# Monaspace, and Newsreader. See mockups/FontsGH/README.md for family
# sources and license posture.
mockups/FontsGH/LICENSE-*.txt -whitespace
